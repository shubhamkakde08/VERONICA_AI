# /etc/systemd/system/reportbot.service  - ReportBot / VERONICA without Docker (Ubuntu / Debian server)
[Unit]
Description=ReportBot VERONICA
After=network-online.target mysql.service
Wants=network-online.target

[Service]
User=reportbot
WorkingDirectory=/opt/reportbot
EnvironmentFile=/opt/reportbot/.env
ExecStart=/opt/reportbot/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
