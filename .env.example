# ---------- Claude ----------
ANTHROPIC_API_KEY=sk-ant-xxxxx
CLAUDE_MODEL=claude-sonnet-5-5

# ---------- Your business MySQL (READ-ONLY user strongly recommended) ----------
# Create one with:  CREATE USER 'reportbot_ro'@'%' IDENTIFIED BY '...';
#                   GRANT SELECT ON your_erp_db.* TO 'reportbot_ro'@'%';
# Without Docker use 127.0.0.1 (MySQL on this PC). With Docker use host.docker.internal.
DATA_DB_URL=mysql+pymysql://reportbot_ro:password@127.0.0.1:3306/your_erp_db?charset=utf8mb4

# ---------- Bot's own storage (skills, history, users, schedules) ----------
# Can be a separate schema on the same MySQL server. This user needs read+write.
BOT_DB_URL=mysql+pymysql://reportbot_rw:password@127.0.0.1:3306/reportbot?charset=utf8mb4


# ---------- Web ----------
PUBLIC_BASE_URL=https://reports.yourcompany.com
# Key that n8n (and other systems) send in the X-API-Key header
SERVICE_API_KEY=change-me-long-random-key
# First admin, created automatically on first start
BOOTSTRAP_ADMIN_NAME=admin
BOOTSTRAP_ADMIN_WEB_TOKEN=change-me-admin-token

# ---------- Limits ----------
MAX_ROWS=5000
QUERY_TIMEOUT_SECONDS=30
TIMEZONE=Asia/Kolkata
COMPANY_NAME=Your Company

# ---------- Web login ----------
# true  = everyone signs in with username + password (personal ?token= links stop working)
# false = old behaviour: personal links with ?token=
WEB_REQUIRE_PASSWORD=true
SESSION_HOURS=12
LOGIN_MAX_FAILS=5
LOGIN_LOCK_MINUTES=15

# ---------- Web look ----------
ASSISTANT_NAME=VERONICA
ASSISTANT_TAGLINE=Your Smart Partner in Pipes & Tubes

# ---------- Voice (Google Gemini) ----------
# Key from https://aistudio.google.com/apikey  - leave empty to switch the voice off
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_STT_MODEL=gemini-3.8-flash
# Warm female voice. For an Indian voice from Google's voice library run:  python -m tools.manage voices hi-IN
GEMINI_VOICE=Sulafat
# true = only this exact voice + model, never a backup/phone voice
VOICE_STRICT=true
VOICE_STYLE=warm, sincere and polite, calm clear pace, like a caring Indian colleague
# browser = instant listening in Chrome/Edge (default) ; gemini = record + Gemini (slower, best for mixed Hinglish)
VOICE_INPUT=browser
# Faster answers for spoken questions only (optional): CLAUDE_VOICE_MODEL=claude-haiku-5-5
CLAUDE_VOICE_MODEL=

# ---------- Live talking (Gemini Live: real-time, interruptible, ~1 s replies) ----------
# Talk button uses Live when GEMINI_API_KEY is set. Data questions still go to Claude on MySQL.
# false (default) = Talk uses the EXACT chat voice: listen -> answer -> speak (4-5 s). true = Gemini Live (faster)
LIVE_ENABLED=false
# tts = Talk uses the SAME voice as chat and 'manage say' (GEMINI_VOICE). native = Live's own voice (fastest, sounds different)
LIVE_VOICE_MODE=tts
# comma list = tried in order. 3.1-flash-live is legacy and may ignore the voice (sounds male)
GEMINI_LIVE_MODEL=gemini-3.8-live
# Female voices: Sulafat (warm), Kore, Aoede, Leda, Zephyr, Despina, Achernar.  Male (avoid): Puck, Charon, Fenrir, Orus
GEMINI_LIVE_VOICE=Sulafat
# empty = she follows any language you speak (best). Set hi-IN etc. only to force one
LIVE_LANGUAGE_CODE=
# true = she keeps talking while data loads ; set false if Live gives a connect error
LIVE_NONBLOCKING=true
# pause (ms) that ends your sentence. Lower = faster, higher = fewer cut-offs
LIVE_SILENCE_MS=700

# ---------- PDF on Windows (only if you installed MSYS2 + pango) ----------
# WEASYPRINT_DLL_DIRECTORIES=C:\msys64\mingw64\bin
